{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cadastro bem-sucedido de usuário",
  "type": "object",
  "required": [
    "id",
    "email"
  ],
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer",
      "examples": [
        1
      ],
      "minimum": 1
    },
    "email": {
      "title": "Email",
      "type": "string",
      "examples": [
        "usuario@example.com"
      ],
      "minLength": 1,
      "format": "email"
    }
  },
  "additionalProperties": false
}
