{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cadastro bem-sucedido de dispositivo",
  "type": "object",
  "required": [
    "id",
    "unidadeConsumidora",
    "nome",
    "potenciaNominal",
    "status",
    "consumoMinimoAtivo",
    "tempoOciosidadeLimite"
  ],
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer",
      "examples": [
        301
      ],
      "minimum": 1
    },
    "unidadeConsumidora": {
      "title": "Unidadeconsumidora",
      "type": "object",
      "required": [
        "id",
        "endereco",
        "nome",
        "tipo",
        "areaTotal"
      ],
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer",
          "examples": [
            201
          ],
          "minimum": 1
        },
        "endereco": {
          "title": "Endereco",
          "type": "object",
          "required": [
            "id",
            "bairro",
            "rua",
            "numero",
            "cep",
            "cidade",
            "uf"
          ],
          "properties": {
            "id": {
              "title": "Id",
              "type": "integer",
              "examples": [
                101
              ],
              "minimum": 1
            },
            "bairro": {
              "title": "Bairro",
              "type": "string",
              "examples": [
                "Bairro Exemplo"
              ],
              "minLength": 1
            },
            "rua": {
              "title": "Rua",
              "type": "string",
              "examples": [
                "Rua Exemplo"
              ],
              "minLength": 1
            },
            "numero": {
              "title": "Numero",
              "type": "string",
              "examples": [
                "100"
              ],
              "minLength": 1
            },
            "cep": {
              "title": "Cep",
              "type": "string",
              "examples": [
                "01001000"
              ],
              "minLength": 1
            },
            "cidade": {
              "title": "Cidade",
              "type": "string",
              "examples": [
                "Cidade Exemplo"
              ],
              "minLength": 1
            },
            "uf": {
              "title": "Uf",
              "type": "string",
              "examples": [
                "SP"
              ],
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "nome": {
          "title": "Nome",
          "type": "string",
          "examples": [
            "Unidade Exemplo"
          ],
          "minLength": 1
        },
        "tipo": {
          "title": "Tipo",
          "type": "string",
          "examples": [
            "COMERCIAL"
          ],
          "minLength": 1,
          "enum": [
            "ADMINISTRATIVO",
            "COMERCIAL",
            "INDUSTRIAL",
            "OUTRO"
          ]
        },
        "areaTotal": {
          "title": "Areatotal",
          "type": "number",
          "examples": [
            250.75
          ],
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "nome": {
      "title": "Nome",
      "type": "string",
      "examples": [
        "Dispositivo Exemplo"
      ],
      "minLength": 1
    },
    "potenciaNominal": {
      "title": "Potencianominal",
      "type": "number",
      "examples": [
        1200.5
      ],
      "exclusiveMinimum": 0
    },
    "status": {
      "title": "Status",
      "type": "string",
      "examples": [
        "LIGADO"
      ],
      "minLength": 1,
      "enum": [
        "ATIVO",
        "INATIVO",
        "LIGADO",
        "DESLIGADO"
      ]
    },
    "consumoMinimoAtivo": {
      "title": "Consumominimoativo",
      "type": "number",
      "examples": [
        0.5
      ],
      "exclusiveMinimum": 0
    },
    "tempoOciosidadeLimite": {
      "title": "Tempoociosidadelimite",
      "type": "integer",
      "examples": [
        30
      ],
      "minimum": 1
    }
  },
  "additionalProperties": false
}
